# ─────────────────────────────────────────────────────────────
#  ROBITA · 환경설정 예시
#  이 파일을 같은 폴더에 ".env" 라는 이름으로 복사한 뒤 값을 채우세요.
#      (윈도우 PowerShell)  Copy-Item .env.example .env
#      (macOS / Linux)      cp .env.example .env
#  .env 파일이 없어도 앱은 그대로 실행됩니다(규칙 기반 모드).
# ─────────────────────────────────────────────────────────────

# 카카오 지도 JavaScript 키
#  - 비워 두면 코드에 들어 있는 기본 키를 사용합니다.
#  - 본인 키를 쓰려면 아래 주석을 풀고 값을 넣으세요.
#  - 발급: https://developers.kakao.com
#  - ※ 카카오 개발자센터 > 앱 설정 > 플랫폼 > Web 에
#       http://localhost:8000 과 실행 PC 의 LAN 주소를 등록해야 지도가 뜹니다.
# KAKAO_JS_KEY=

# 카카오모빌리티 길찾기(Directions) REST 키
#  - 비워 두면 경로가 '직선'으로 표시됩니다(앱은 정상 실행).
#  - 키를 넣으면 실제 도로 경로를 따라 차량이 달립니다.
#  - 자동차 길찾기 API 는 하루 1만 건 무료입니다.
#  - ※ 일반 카카오 개발자 사이트가 아니라 별도 사이트에서 발급:
#       https://developers.kakaomobility.com
KAKAO_REST_KEY=

# OpenAI(ChatGPT) API 키
#  - 값이 있으면 OpenAI 를 우선 사용합니다.
#  - 발급: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# 모델 선택 — 빠르게: gpt-4.1-nano / 품질: gpt-4.1 / 기본: gpt-4.1-mini
OPENAI_MODEL=gpt-4.1-mini

# Google Gemini API 키
#  - OpenAI 키가 없을 때 사용합니다. 둘 다 비면 규칙 기반 모드로 동작합니다.
#  - 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 세션 쿠키 서명용 비밀키 — 실제 배포 시 반드시 임의의 긴 문자열로 변경하세요.
SECRET_KEY=robotaxi-local-development

# 시뮬레이션 차량 대수
FLEET_SIZE=47

# 시뮬레이션 갱신 주기(초). 작을수록 화면이 더 자주 움직입니다.
TICK_SECONDS=2.0

# SQLite DB 파일 경로 (비워 두면 프로젝트 폴더의 robotaxi.db 사용)
# DB_PATH=
